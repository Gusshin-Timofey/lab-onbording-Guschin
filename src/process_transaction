def process_transaction(user_id, amount, db_connection):
    # Инициализация переменной для предотвращения UnboundLocalError
    status = "pending"
    
    if amount > 0:
        status = "approved"
        balance = get_balance(user_id)
        new_balance = balance - amount
        update_balance(user_id, new_balance)
    
    # Исправлено мертвое присваивание (данные пишутся в лог)
    log_entry = f"Transaction finished with status: {status}"
    
    # Безопасная работа с файлом через context manager (утечка устранена)
    with open("audit_log.txt", "w") as file:
        file.write(log_entry)
    
    return status
